# API token from Survio (ask Survio support); every token has full access to the account. Set it with `survio auth setup`.
SURVIO_API_TOKEN=
# 1 turns write commands (invitations) on; anything else, or empty, keeps them off.
SURVIO_ALLOW_WRITES=
# auto (default), cli or mcp; the skills read it from the shell environment, not from this file.
SURVIO_ROUTE=
# Override the API base URL (default https://api2.survio.com/v2); for tests only.
SURVIO_API_URL=
